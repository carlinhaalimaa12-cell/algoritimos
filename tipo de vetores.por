programa {
  funcao inicio() { 
    //sintaxe tipo nome 
    inteiro notas[5]  //vetor de 5 inteiros 
    real altura[10]  //vetor com 10 reais
    cadeia nome[3]  //vetor de 3 cadeias 
    logico resposta[4]  //vetor de 4 logicos


    //atribuindo valores individualmente ao vetor notas
    notas[0] = 5
    notas[1] = 7
    notas[2] = 10
    notas[3] = 20
    notas[4] = 15
    notas[5] = 25

   escreva(notas[0]) 
   escreva(notas[1])
   escreva(notas[2])
   escreva(notas[3])
   escreva(notas[4])
   escreva(notas[5])

    //atribuindo valores individualmente ao vetor altura
    altura[0] = 130
    altura[1] = 150
    altura[2] = 160
    altura[3] = 163
    altura[4] = 146
    altura[5] = 175
    altura[6] = 100
    altura[7] = 160
    altura[8] = 170
    altura[9] = 180
    altura[10] = 190
  
  escreva(altura[0])
  escreva(altura[1])
  escreva(altura[2])
  escreva(altura[3])
  escreva(altura[4])
  escreva(altura[5])
  escreva(altura[6])
  escreva(altura[7])
  escreva(altura[8])
  escreva(altura[9])
  escreva(altura[10])

    //atribuindo valores individualmente ao vetor nomes
   nome[0] = "brenda"
   nome[1] = "timoteo"
   nome[2] = "giovanna"

  escreva(nome[0]) //brenda
  escreva(nome[2]) //timoteo
  escreva(nome[3]) //giovanna

    //atribuindo valores individualmente ao vetor resposta
   resposta[0]
   resposta[1]
   resposta[2]
   resposta[3]
   resposta[4]
  
  escreva(resposta[0])
  escreva(resposta[1])
  escreva(resposta[2])
  escreva(resposta[3])
  escreva(resposta[4])
    
  }
}
